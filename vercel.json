{
  "version": 2,
  "outputDirectory": "public",
  "functions": { "api/agent.mjs": { "maxDuration": 60 }, "api/auth.mjs": { "maxDuration": 30 }, "api/observatory.mjs": { "maxDuration": 30 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
  ]}]
}
