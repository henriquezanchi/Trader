# Apenas no servidor da Vercel. Nunca use prefixo NEXT_PUBLIC para estes valores.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Exclusivo do agendador; não é senha de usuário. Gere com: openssl rand -hex 32
BOT_TOKEN=
# Opcional, caso use uma chave gratuita Demo da CoinGecko:
COINGECKO_DEMO_API_KEY=

# Obrigatório para instalações anteriores sem initialCapital no estado:
INITIAL_BALANCE_BRL=

# Acesso humano via Supabase Auth; somente no servidor.
SUPABASE_ANON_KEY=
# URLs HTTPS em produção; para desenvolvimento local use a origem abaixo.
APP_ORIGIN=http://127.0.0.1:3000
# Listas privadas separadas por vírgulas. Nunca coloque e-mails reais no Git.
TRADE_LAB_USER_IDS=
TRADE_LAB_EMAILS=
